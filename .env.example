# Copy to .env, or run `npm run keys` to generate a .env with fresh random secrets.

# --- Server ---
HOST=localhost
HTTPS_PORT=8443
# Plain-HTTP port that only issues 301 redirects to HTTPS (no app routes are served on it)
HTTP_PORT=8080

# --- TLS (data in motion) ---
TLS_KEY_PATH=certs/server.key
TLS_CERT_PATH=certs/server.crt
TLS_CA_PATH=certs/ca.crt
# Demo/PoC only: when set, TLS session secrets are written here so Wireshark can
# decrypt the capture (proves the data is really there, just encrypted). Leave empty normally.
TLS_KEYLOG_FILE=

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/secure_auth

# --- Data at rest ---
# 32-byte AES-256 key (64 hex chars) used to encrypt email addresses
AES_KEY=
# 32-byte HMAC key (64 hex chars) used for the searchable "blind index" of the email
EMAIL_HMAC_KEY=

# --- Passwords ---
BCRYPT_ROUNDS=12

# --- Session ---
JWT_SECRET=
JWT_EXPIRES_IN=1h
